<?xml version="1.0" encoding="utf-8"?>
<SystemConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" schemaVersion="1.0" xmlns="http://www.ni.com/TestStand/SemiconductorModule/SystemConfiguration.xsd">

    <PXIChassis Number="1" Model="NI PXIe-1095">
        <!-- Digital Pattern Instruments -->
        <PXI Name="HSD_6571_C1_S05" Model="NI PXIe-6571" Slot="5" />
        <PXI Name="HSD_6571_C1_S06" Model="NI PXIe-6571" Slot="6" />
        <PXI Name="HSD_6571_C1_S07" Model="NI PXIe-6571" Slot="7" />
        <PXI Name="HSD_6571_C1_S014" Model="NI PXIe-6571" Slot="14" />
        
        <!-- Source Measure Units (SMUs) -->
        <PXI Name="SMU_4147_C1_S16" Model="NI PXIe-4147" Slot="16" />
        <PXI Name="SMU_4147_C1_S17" Model="NI PXIe-4147" Slot="17" />

        <!-- Relay Driver Module (Changed PXIe to PXI) -->
        <PXI Name="RELAY_2567_C1_S11" Model="NI PXI-2567" Slot="11" />
        <PXI Name="RELAY_2567_C1_S12" Model="NI PXI-2567" Slot="12" />
    </PXIChassis>

    <PXIChassis Number="2" Model="NI PXIe-1095">
        <!-- Oscilloscope Instrument (Changed to the highly compatible 5105 for simulation) -->
        <PXI Name="SCOPE_5172_C2_S02" Model="NI PXIe-5172 (8CH - 325T)" Slot="2" />
        <PXI Name="SCOPE_5172_C2_S04" Model="NI PXIe-5172 (8CH - 325T)" Slot="4" />
        
        <!-- Programmable Power Supply (PPS) -->
        <PXI Name="PPS_4110_C2_S12" Model="NI PXI-4110" Slot="12" />

        <!-- Source Measure Units (SMUs) -->
        <PXI Name="SMU_4147_C2_S15" Model="NI PXIe-4147" Slot="15" />
        <PXI Name="SMU_4147_C2_S16" Model="NI PXIe-4147" Slot="16" />
        <PXI Name="SMU_4147_C2_S17" Model="NI PXIe-4147" Slot="17" />
        <PXI Name="SMU_4147_C2_S18" Model="NI PXIe-4147" Slot="18" />

        <!-- Function Generator(FGEN) (Changed to supported simulation model 5451) -->
        <PXI Name="FGEN_5433_C2_S08" Model="NI PXIe-5433 (2CH)" Slot="8" />

        <!-- Digital Multimeter(DMM) -->
        <PXI Name="DMM_4081_C2_S13" Model="NI PXIe-4081" Slot="13" />
    </PXIChassis>
</SystemConfiguration>